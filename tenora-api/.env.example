# Copy this file to .env for local development. Do not commit .env.
# Passwords here are local-only placeholders — change them if you expose Postgres.

NODE_ENV=development
PORT=3000
API_PORT=3000

# Postgres container bootstrap (superuser). Used only for init and admin.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tenora_postgres_dev
POSTGRES_DB=tenora
POSTGRES_PORT=5432

# Migration role: owns schema objects (DDL).
MIGRATE_DB_USER=tenora_migrate
MIGRATE_DB_PASSWORD=tenora_migrate_dev

# Application role: DML only (SELECT/INSERT/UPDATE/DELETE).
APP_DB_USER=tenora_app
APP_DB_PASSWORD=tenora_app_dev

# NestJS connection (application role). Host is localhost when the API runs on the host.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tenora
DATABASE_USER=tenora_app
DATABASE_PASSWORD=tenora_app_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10
